# Public Cloud dev configuration. Copy to ignored .env.local and replace locally.
# Dashboard campusfind-dev: Project URL + API Keys > Publishable key.
# Landing/build remain usable without these values. Restart dev after changes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Never add a secret/service-role key, database password or CLI access token here.

# Trusted application origin for email links and safe auth redirects.
# Set to your HTTPS application origin outside localhost development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
